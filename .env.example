# fin-data-mcp configuration. All optional — the server runs against ~13 no-key
# providers with zero configuration. Keys here only unlock higher limits or the
# few providers that started requiring a free key.

# SEC EDGAR requires a descriptive User-Agent with a contact. Strongly recommended.
SEC_USER_AGENT="fin-data-mcp (your-email@example.com)"

# Ember Energy now requires a FREE key. Get one: https://api.ember-energy.org/signup
EMBER_API_KEY=

# Tiingo free key — optional premium equities backup (clean EOD + IEX intraday).
# No-key equities still work via yahoo_* and cboe_*. https://www.tiingo.com/
TIINGO_API_KEY=

# --- Optional keyed providers ---------------------------------------------
# Each provider's tools are registered ONLY when its key is set, so leaving
# these blank keeps the tool list clean (no broken/unusable tools appear).
#
# FRED — macro/economic series.        https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Finnhub — real-time stocks + fundamentals.   https://finnhub.io/register
FINNHUB_API_KEY=
# Alpha Vantage — commodities/equities/FX/macro.  https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# EIA — US energy data.                https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# Quiver Quantitative — congress/lobbying/contracts.  https://www.quiverquant.com/
QUIVER_API_KEY=

# OpenSky Network — optional OAuth2 client credentials raise your rate limit
# (anonymous works but is capped at ~400 credits/day). https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Stock Watcher source overrides (defaults to the community GitHub mirror because
# the original S3 buckets went private). Point these at your own copy if needed.
# HOUSE_STOCK_WATCHER_URL=
# SENATE_STOCK_WATCHER_URL=

# HTTP behavior
HTTP_TIMEOUT_MS=15000
CACHE_TTL_MS=60000
